PORT=3001
NODE_ENV=development
API_PREFIX=api

APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

JWT_SECRET="thay-bang-mot-chuoi-ngau-nhien-bi-mat"

JWT_EXPIRES_IN="15m"

REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Có REDIS_URL thì dùng nó và bỏ qua 4 biến dưới
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Store Web <no-reply@store-web.local>"

MAIL_QUEUE_ENABLED=false

# Tài khoản admin đầu tiên do prisma/seed.ts tạo.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@store-web.local
ADMIN_PASSWORD=admin123

# Secret dùng chung với cổng thanh toán để ký/kiểm callback (HMAC-SHA256).
# Thiếu biến này thì MỌI callback bị từ chối — fail closed, không bỏ qua kiểm tra.
PAYMENT_CALLBACK_SECRET=

# Lưu ảnh: S3 hoặc Cloudflare R2 (cùng giao thức).
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com 
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 và các S3-compatible khác cần true; AWS S3 để trống.
S3_FORCE_PATH_STYLE=
# Domain công khai để dựng URL ảnh
S3_PUBLIC_URL=

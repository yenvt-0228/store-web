PORT=3001
NODE_ENV=development
API_PREFIX=api

APP_ROLE=all

APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

MIGRATE_DATABASE_URL=

JWT_SECRET="replace-with-a-random-secret-string"

JWT_EXPIRES_IN="15m"

REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# If REDIS_URL is present, use it and ignore the 4 variables below.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Store Web <no-reply@store-web.local>"

MAIL_QUEUE_ENABLED=false

REPORT_QUEUE_ENABLED=false

# Kafka: domain event bus (orders) other services can read. Left false, the
# module is not loaded at all and the app behaves exactly as before.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=store-web
# Every replica shares one group so a message is handled exactly once.
KAFKA_GROUP_ID=store-web-api
# Only managed clusters (Confluent, Redpanda Cloud, MSK) need TLS + SASL.
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# First admin account, created by prisma/seed.ts.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@store-web.local
ADMIN_PASSWORD=admin123

# Secret shared with the payment gateway to sign and verify callbacks
# (HMAC-SHA256). Without it EVERY callback is rejected: fail closed, never skip
# the check.
PAYMENT_CALLBACK_SECRET=

# Image storage: S3 or Cloudflare R2 (same protocol).
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 and other S3-compatible providers need true; leave empty for AWS S3.
S3_FORCE_PATH_STYLE=
# Public domain used to build image URLs.
S3_PUBLIC_URL=

# Google sign-in. The ID token flow only needs CLIENT_ID, used as the audience
# when verifying. CLIENT_SECRET is only needed for the OAuth2 redirect flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

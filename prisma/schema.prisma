generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

model User {
  id       String  @id @default(uuid(7)) @db.Uuid
  name     String  @db.VarChar(255)
  email    String  @unique @db.VarChar(255)
  password String?  @db.VarChar(255)
  googleId String? @unique @map("google_id") @db.VarChar(255)
  phone    String? @db.VarChar(20)
  address  String? @db.VarChar(255)
  avatar   String? @db.VarChar(500)

  status     UserStatus @default(ACTIVE)
  isVerified Boolean    @default(false) @map("is_verified")

  locale String @default("vi") @db.VarChar(5)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles                   UserRole[]
  orders                  Order[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String  @unique @db.VarChar(50) // ADMIN | USER (xem RoleName)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

// Bảng nối user <-> role (N-N)
model UserRole {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId]) // khóa chính gộp -> không thể gán trùng 1 role cho 1 user
  @@map("user_roles")
}

model RefreshToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique // sha256(refresh token)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique @db.VarChar(255) // sha256(activation token)

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at") // đã dùng rồi thì không kích hoạt lại được
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique @db.VarChar(255) // sha256(reset token)

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// bật/tắt bán hàng
enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

// Vòng đời đơn hàng.
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
  REJECTED

  @@map("order_status")
}

// Trạng thái thanh toán Đơn hàng
enum OrderPaymentStatus {
  UNPAID
  PAID
  REFUNDED

  @@map("order_payment_status")
}

// Trạng thái thanh toán.
enum PaymentStatus {
  PENDING
  PAID
  FAILED

  @@map("payment_status")
}

// Phương thức thanh toán
enum PaymentMethod {
  COD
  ONLINE

  @@map("payment_method")
}

model Category {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String  @unique @db.VarChar(255)
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id String @id @default(uuid(7)) @db.Uuid

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  name        String  @db.VarChar(255)
  description String?
  price       Decimal @db.Decimal(12, 2)
  quantity    Int     @default(0)

  status     ProductStatus @default(ACTIVE)
  isFeatured Boolean       @default(false) @map("is_featured")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status, deletedAt])
  @@map("products")
}

enum ImageEntityType {
  USER
  PRODUCT

  @@map("image_entity_type")
}

model Image {
  id String @id @default(uuid(7)) @db.Uuid

  entityId   String          @map("entity_id") @db.Uuid
  entityType ImageEntityType @map("entity_type")

  imageUrl String @map("image_url") @db.VarChar(500)

  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([entityType, entityId, sortOrder])
  @@index([deletedAt])
  @@map("images")
}

model Order {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  orderCode String @unique @map("order_code") @db.VarChar(50)

  status        OrderStatus        @default(PENDING)
  paymentStatus OrderPaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod PaymentMethod      @map("payment_method")

  totalAmount Decimal @map("total_amount") @db.Decimal(12, 2)

  shippingName    String @map("shipping_name") @db.VarChar(255)
  shippingPhone   String @map("shipping_phone") @db.VarChar(20)
  shippingAddress String @map("shipping_address")

  cancelReason String? @map("cancel_reason")
  rejectReason String? @map("reject_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   OrderItem[]
  payment Payment?

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  productName  String  @map("product_name") @db.VarChar(255)
  productPrice Decimal @map("product_price") @db.Decimal(12, 2)

  quantity Int
  subtotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id String @id @default(uuid(7)) @db.Uuid

  orderId       String        @unique @map("order_id") @db.Uuid
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @map("payment_method")
  transactionId String?       @unique @map("transaction_id") @db.VarChar(100)

  amount Decimal       @db.Decimal(12, 2)
  status PaymentStatus @default(PENDING)

  paymentData Json?     @map("payment_data")
  paidAt      DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("payments")
}
